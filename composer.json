{
    "name": "kyzegs/supabase-auth-bundle",
    "description": "A reusable Symfony bundle for stateless authentication via Supabase-issued JWTs.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "supabase",
        "jwt",
        "security",
        "authentication",
        "access-token"
    ],
    "authors": [
        {
            "name": "Sebastiaan \"Kyzegs\" Zegers",
            "email": "kyzegs@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/kyzegs/supabase-auth-bundle/issues",
        "source": "https://github.com/kyzegs/supabase-auth-bundle"
    },
    "require": {
        "php": "^8.3",
        "web-token/jwt-library": "^4.1.4",
        "symfony/cache-contracts": "^3.4",
        "symfony/clock": "^7.0|^8.0",
        "symfony/config": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/http-client-contracts": "^3.4",
        "symfony/http-kernel": "^7.0|^8.0",
        "symfony/security-core": "^7.0|^8.0",
        "symfony/security-http": "^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "symfony/cache": "^7.0|^8.0",
        "symfony/framework-bundle": "^7.0|^8.0",
        "symfony/http-client": "^7.0|^8.0",
        "symfony/security-bundle": "^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Kyzegs\\SupabaseAuthBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kyzegs\\SupabaseAuthBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "extra": {
        "symfony": {
            "require": "^7.0|^8.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
